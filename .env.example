# PostgreSQL
POSTGRES_DB=hosting_db
POSTGRES_USER=hosting_app
POSTGRES_PASSWORD=CAMBIAR_PASSWORD

# Conexión del backend
ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=hosting_db;Username=hosting_app;Password=CAMBIAR_PASSWORD

# Almacenamiento persistente del host
HOST_STORAGE_ROOT=/ruta/absoluta/terraria-hosting/servers
HOST_DATA_PROTECTION=/ruta/absoluta/terraria-hosting/keys

# Configuración de la aplicación
Auth__FrontendUrl=http://localhost:5173
Auth__BaseUrl=http://localhost:5157
Cors__AllowedOrigins=http://localhost:5173

# Google
Auth__Google__ClientId=
Auth__Google__ClientSecret=

# GitHub
Auth__GitHub__ClientId=
Auth__GitHub__ClientSecret=

# Discord
Auth__Discord__ClientId=
Auth__Discord__ClientSecret=