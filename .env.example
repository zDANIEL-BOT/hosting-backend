# =============================================================
# Variables de entorno del BACKEND (Hosting.Api)
# Copia este archivo como `.env` y completa los valores reales.
# NUNCA subas el `.env` con claves reales al repositorio.
# =============================================================

# --- Base de datos (PostgreSQL) ---
ConnectionStrings__DefaultConnection=Host=db;Port=5432;Database=hosting;Username=postgres;Password=dreadvorteyt293

# --- URLs públicas de la aplicación ---
Auth__FrontendUrl=http://localhost:5173
Auth__BaseUrl=http://localhost:5001

# --- Orígenes CORS permitidos (separados por coma) ---
Cors__AllowedOrigins=http://localhost:5173

# --- Credenciales OAuth (SSO) ---
# Discord: https://discord.com/developers/applications
#   Redirect URI:  http://localhost:5001/signin-Discord
Auth__Discord__ClientId=
Auth__Discord__ClientSecret=

# GitHub: https://github.com/settings/developers (OAuth Apps)
#   Authorization callback URL:  http://localhost:5001/signin-GitHub
Auth__GitHub__ClientId=
Auth__GitHub__ClientSecret=

# Google: https://console.cloud.google.com/apis/credentials
#   Redirect URI:  http://localhost:5001/signin-Google
Auth__Google__ClientId=
Auth__Google__ClientSecret=

# TikTok: https://developers.tiktok.com (Login Kit)
#   Redirect URI:  http://localhost:5001/signin-TikTok
Auth__TikTok__ClientId=
Auth__TikTok__ClientSecret=